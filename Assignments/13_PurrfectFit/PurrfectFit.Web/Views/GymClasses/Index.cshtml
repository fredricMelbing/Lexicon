@model IEnumerable<PurrfectFit.Core.Entities.GymClass>

@{
    var isHistory = ViewData["IsHistory"] as bool? ?? false;
    var currentAction = ViewData["CurrentAction"] as string ?? "Index";
    ViewData["Title"] = isHistory ? "Gym Class History" : "Gym Class Schedule";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@(isHistory ? "⏳ Past Gym Classes" : "🐾 Available Gym Classes")</h2>

        @if (currentAction == "Index")
        {
            <a asp-action="History" class="btn btn-outline-secondary">
                <i class="fas fa-history"></i> View Past History
            </a>
        }
        else if (currentAction == "History")
        {
            <a asp-action="Index" class="btn btn-outline-primary">
                <i class="fas fa-calendar-alt"></i> View Current Schedule
            </a>
        }
        else if (currentAction == "MyBookings")
        {
            <a asp-action="MyBookingsHistory" class="btn btn-outline-secondary">
                <i class="fas fa-history"></i> View My Past History
            </a>
        }
        else if (currentAction == "MyBookingsHistory")
        {
            <a asp-action="MyBookings" class="btn btn-outline-primary">
                <i class="fas fa-calendar-alt"></i> View My Active Bookings
            </a>
        }

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Schedule" class="btn btn-primary">
                <i class="fas fa-calendar-plus"></i> Schedule New Class
            </a>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Name)</th>
                            <th>@Html.DisplayNameFor(model => model.StartTime)</th>
                            <th>@Html.DisplayNameFor(model => model.Duration)</th>
                            <th>@Html.DisplayNameFor(model => model.EndTime)</th>
                            <th>@Html.DisplayNameFor(model => model.Description)</th>
                            <th>Attendees</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No gym classes scheduled at the moment. Purr-haps you should create one?
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="font-weight-bold">@item.Name</td>
                                    <td>@item.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.Duration.TotalMinutes min</td>
                                    <td>@item.EndTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-truncate" style="max-width: 250px;">@item.Description</td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            <i class="fas fa-users"></i> @item.AttendingMembers.Count cats
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <div class="d-flex justify-content-center align-items-center gap-2">

                                            @if (isHistory)
                                            {
                                                <button class="btn btn-sm btn-secondary" disabled>
                                                    <i class="fas fa-lock"></i> Class Ended
                                                </button>
                                            }
                                            else
                                            {
                                                @if (User.Identity?.IsAuthenticated == true)
                                                {
                                                    var isBooked = item.AttendingMembers.Any(am => am.ApplicationUser?.UserName == User.Identity.Name);

                                                    <form asp-action="BookingStatus" asp-route-id="@item.Id" method="post" class="m-0">
                                                        @if (isBooked)
                                                        {
                                                            <button type="submit" class="btn btn-sm btn-danger">
                                                                <i class="fas fa-calendar-times"></i> Unbook
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="submit" class="btn btn-sm btn-success">
                                                                <i class="fas fa-calendar-check"></i> Book
                                                            </button>
                                                        }
                                                    </form>
                                                }
                                                else
                                                {
                                                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-sm btn-secondary">
                                                        <i class="fas fa-sign-in-alt"></i> Login to Book
                                                    </a>
                                                }
                                            }

                                            <div class="btn-group" role="group">
                                                @if (User.Identity?.IsAuthenticated == true)
                                                {
                                                    @if (User.IsInRole("Admin"))
                                                    {
                                                        <a asp-action="Reschedule" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Reschedule</a>
                                                        <a asp-action="Cancel" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Cancel</a>
                                                    }
                                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
