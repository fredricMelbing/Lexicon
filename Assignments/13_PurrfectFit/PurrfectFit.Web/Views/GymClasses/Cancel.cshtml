@model PurrfectFit.Core.Entities.GymClass

@{
    ViewData["Title"] = "Cancel Gym Class";
}

<div class="container mt-4">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h2 class="mb-0">⚠️ Cancel Gym Class</h2>
        </div>
        <div class="card-body">
            <h3 class="text-danger">Are you sure you want to cancel this class?</h3>
            <p>This action cannot be undone.</p>
            <hr />
            <dl class="row">
                <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Name)</dt>
                <dd class="col-sm-10">@Model.Name</dd>
                <dt class="col-sm-2">Start Time</dt>
                <dd class="col-sm-10">@Model.StartTime.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>

            <form asp-action="Cancel" method="post">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-danger">Confirm Cancel</button>
            </form>
        </div>
    </div>
</div>