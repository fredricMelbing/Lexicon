@model GymClassBaseViewModel

@foreach (var property in ViewData.ModelMetadata.Properties)
{
    // Skip the Id property as it shouldn't be rendered as an input field
    if (property.PropertyName == "Id") continue;

    var propertyName = property.PropertyName ?? string.Empty;
    var labelText = property.DisplayName ?? propertyName;

    // Extract values and server-side errors from ModelState
    var postedValue = property.PropertyGetter?.Invoke(Model)?.ToString() ?? string.Empty;
    var hasServerError = ViewData.ModelState.TryGetValue(propertyName, out var modelStateEntry);
    var serverErrorMessage = hasServerError ? modelStateEntry?.Errors.FirstOrDefault()?.ErrorMessage : string.Empty;

    // =========================================================================
    // ADVANCED REFLECTION: DYNAMIC HTML5 VALIDATION ATTRIBUTE EXTRACTOR
    // =========================================================================
    var validationAttributes = new Dictionary<string, string>();
    var validationRules = property.ValidatorMetadata;

    if (validationRules.Any() || property.IsRequired)
    {
        validationAttributes.Add("data-val", "true");
    }

    // Automatically map RequiredAttribute
    if (property.IsRequired)
    {
        validationAttributes.Add("data-val-required", $"The {labelText} field is required.");
    }

    // Reflectively extract StringLengthAttribute
    var stringLength = validationRules.OfType<System.ComponentModel.DataAnnotations.StringLengthAttribute>().FirstOrDefault();
    if (stringLength != null)
    {
        var msg = stringLength.ErrorMessage ?? $"The {labelText} must be between {stringLength.MinimumLength} and {stringLength.MaximumLength} characters.";
        msg = msg.Replace("{0}", labelText)
                 .Replace("{1}", stringLength.MaximumLength.ToString())
                 .Replace("{2}", stringLength.MinimumLength.ToString());

        validationAttributes.Add("data-val-length", msg);
        validationAttributes.Add("data-val-length-min", stringLength.MinimumLength.ToString());
        validationAttributes.Add("data-val-length-max", stringLength.MaximumLength.ToString());
    }

    // Reflectively extract RangeAttribute (e.g. if numbers are added in the future)
    var rangeAttr = validationRules.OfType<System.ComponentModel.DataAnnotations.RangeAttribute>().FirstOrDefault();
    if (rangeAttr != null)
    {
        var msg = rangeAttr.ErrorMessage ?? $"The {labelText} must be between {rangeAttr.Minimum} and {rangeAttr.Maximum}.";
        validationAttributes.Add("data-val-range", msg);
        validationAttributes.Add("data-val-range-min", rangeAttr.Minimum?.ToString() ?? string.Empty);
        validationAttributes.Add("data-val-range-max", rangeAttr.Maximum?.ToString() ?? string.Empty);
    }

    // Contextual routing check for DateTime past-validation
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isCreateView = currentAction == "Schedule";
    if (property.ModelType == typeof(DateTime) && isCreateView)
    {
        var currentDateTime = DateTime.Now;

        // HTML5 'min' attribute still needs the 'T' format to lock the calendar input box
        validationAttributes.Add("min", currentDateTime.ToString("yyyy-MM-ddTHH:mm"));

        // FIX: Override jQuery Validation's ugly default message with your clean, user-friendly format
        var cleanDateString = currentDateTime.ToString("yyyy-MM-dd HH:mm");
        validationAttributes.Add("data-msg-min", $"Please enter a value greater than or equal to {cleanDateString}.");        
    }

    // Flatten the dictionary into raw HTML attributes string    
    var htmlAttributes = Html.Raw(string.Join(" ", validationAttributes.Select(a => $"{a.Key}=\"{HtmlEncoder.Encode(a.Value)}\"")));

    <div class="mb-3">
        <label for="@propertyName" class="form-label fw-bold">@labelText</label>

        @* DATETIME RENDERER *@
        @if (property.ModelType == typeof(DateTime))
        {
            var dateValue = property.PropertyGetter?.Invoke(Model) as DateTime?;
            var formattedDate = dateValue?.ToString("yyyy-MM-ddTHH:mm") ?? "";

            <input type="datetime-local" name="@propertyName" id="@propertyName" class="form-control" value="@formattedDate" @htmlAttributes />
        }
        @* TIMESPAN RENDERER *@
        else if (property.ModelType == typeof(TimeSpan))
        {
        <input type="time" name="@propertyName" id="@propertyName" class="form-control" value="@postedValue" @htmlAttributes />
        }
        @* LONG TEXT (DESCRIPTION) RENDERER *@
        else if (propertyName == "Description")
        {
        <textarea name="@propertyName" id="@propertyName" class="form-control" rows="4" placeholder="Enter description..." @htmlAttributes>@postedValue</textarea>
        }
        @* STANDARD TEXT RENDERER *@
        else
        {
        <input type="text" name="@propertyName" id="@propertyName" class="form-control" placeholder="Enter details..." value="@postedValue" @htmlAttributes />
        }

        <span class="text-danger @(hasServerError ? "field-validation-error" : "field-validation-valid")"
              data-valmsg-for="@propertyName"
              data-valmsg-replace="true">
            @serverErrorMessage
        </span>
    </div>
}
