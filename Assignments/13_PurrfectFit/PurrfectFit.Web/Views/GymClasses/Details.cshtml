@model PurrfectFit.Core.Entities.GymClass

@{
    ViewData["Title"] = "Gym Class Details";
}

<div class="container mt-4">    
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white">
            <h2 class="mb-0">🐾 Gym Class Information</h2>
        </div>
        <div class="card-body">
            <h3 class="text-primary mb-3">@Model.Name</h3>
            <hr />

            <dl class="row font-size-md">
                <dt class="col-sm-3 fw-bold">Start Time</dt>
                <dd class="col-sm-9">@Model.StartTime.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-3 fw-bold">Duration</dt>
                <dd class="col-sm-9">@Model.Duration.TotalMinutes minutes</dd>

                <dt class="col-sm-3 fw-bold">End Time</dt>
                <dd class="col-sm-9">@Model.EndTime.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-3 fw-bold">Description</dt>
                <dd class="col-sm-9 text-muted">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No description available for this class." : Model.Description)
                </dd>
            </dl>
                        
            <div class="mt-4 border-top pt-3 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Schedule
                </a>
                <div class="btn-group">
                    <a asp-action="Reschedule" asp-route-id="@Model.Id" class="btn btn-warning">Edit Class</a>
                </div>
            </div>
        </div>
    </div>

    <!-- BOOKED MEMBERS LIST -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0"><i class="fas fa-users"></i> Booked Members (@Model.AttendingMembers.Count)</h4>
        </div>
        <div class="card-body">
            @if (!Model.AttendingMembers.Any())
            {
                <p class="text-muted my-2">No members have booked this class yet.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var booking in Model.AttendingMembers)
                    {
                        <li class="list-group-item d-flex align-items-center">
                            <i class="fas fa-envelope text-secondary me-3"></i>
                            @booking.ApplicationUser?.Email
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>