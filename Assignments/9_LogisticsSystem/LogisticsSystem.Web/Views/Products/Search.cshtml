@model IEnumerable<LogisticsSystem.Web.Models.Product>

@{
    ViewData["Title"] = "Search Warehouse Inventory";
}

<div class="container mt-4">

    <h1>Search Warehouse Inventory</h1>
    <p class="text-muted">Combine product name search and category dropdown filtering.</p>

    <form asp-action="Search" method="get" class="row g-3 p-3 bg-light rounded border mb-4">

        <!-- Dropdown Column (Takes up 4 out of 12 grid spaces) -->
        <div class="col-md-4">
            <label class="form-label fw-bold">Filter by Category</label>
            <select name="category" asp-items="ViewBag.Categories" class="form-select">
                <option value="">-- All Categories --</option>
            </select>
        </div>

        <!-- Text Input Column (Takes up 5 out of 12 grid spaces) -->
        <div class="col-md-5">
            <label class="form-label fw-bold">Search Product Name</label>
            <input type="text" name="searchProduct" value="@ViewBag.SearchProduct" class="form-control" placeholder="Enter product name..." />
        </div>

        <!-- .col-md-3 takes up the remaining 3 grid spaces for action buttons -->
        <div class="col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-success w-100">Search</button>
            <a asp-action="Search" class="btn btn-secondary w-100 text-center">Clear</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            Please enter a category above and click Search to look up items.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>                        
                        <th>Name</th>
                        <th>Category</th>
                        <th>Shelf Location</th>
                        <th>Price</th>
                        <th>Stock Count</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No products match your current search criteria.
                            </td>
                        </tr>
                    }
                    
                    @foreach (var item in Model)
                    {
                        <tr>                            
                            <td class="fw-bold">@item.Name</td>
                            <td><span class="badge bg-secondary">@item.Category</span></td>
                            <td>@item.Shelf</td>
                            <td>@item.Price:-</td>
                            <td>@item.Count pcs</td>
                        </tr>                    
                    }
                </tbody>
            </table>
        </div>
    }
</div>